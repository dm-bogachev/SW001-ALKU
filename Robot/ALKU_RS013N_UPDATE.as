.PROGRAM load.ot.data ()
  ;
  max.count.ot = 0
  WHILE TRUE DO
    max.count.ot = max.count.ot + 1
    IF INSTR ($ot.data, ",")
      .id = VAL ($DECODE ($ot.data, ",", 0))
      CALL ot.table (.id)
      .temp = VAL ($DECODE ($ot.data, ",", 1))
    ELSE
      .id = VAL ($ot.data)
      CALL ot.table (.id)
      RETURN
    END
  END
  ;
.END
