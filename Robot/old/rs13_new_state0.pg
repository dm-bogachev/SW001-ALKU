  SIGNAL -s.cmd.start, -s.cmd.pick, -s.cmd.finish, -rs13.finish, -s.cmd.stop
  SIGNAL -s.cmd.chg.opt, -s.cmd.pause, -s.cmd.n.op.stop, -rs13.no.ot.stop
  ;
  SIGNAL -s.stock.opt.ng, -s.stock.ot.ng, -s.stock.opt.ok, -s.stock.ot.ok
