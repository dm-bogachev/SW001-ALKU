  SPEED 100 MM/S
  LMOVE ot.point[.i,.j]
  BREAK
  PULSE release.tare
  TWAIT 0.5
  SIGNAL -s.ot.placed
;
  ACCURACY 10
  LMOVE ot.point[.i,.j]+TRANS(0,0,50)
;
  ACCEL 100 ALWAYS
  DECEL 100 ALWAYS
.END
