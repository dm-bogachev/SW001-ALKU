.PROGRAM load.opt.data()@26/01/15 08:39 #227
;
  CALL log("Load OPT IDs from string: "+$opt.data)
  max.count.opt = 0
  WHILE TRUE DO
    max.count.opt = max.count.opt+1
    IF INSTR($opt.data , ",") THEN
      .id = VAL($DECODE($opt.data,",",0))
      CALL opt.table(.id)
      .temp = VAL($DECODE($opt.data,",",1))
    ELSE
      .id = VAL($opt.data)
      CALL opt.table(.id)
      RETURN
    END
  END
;
.END
.PROGRAM load.ot.data()@26/01/15 08:39 #227
;
  max.count.ot = 0
  WHILE TRUE DO
    max.count.ot = max.count.ot+1
