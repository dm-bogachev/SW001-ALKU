;
    IF NOT SIG(s.debug.mode) THEN
      IF SWITCH(REPEAT ) AND NOT SWITCH(TEACH_LOCK ) AND NOT SWITCH(EMERGENCY ) AND NOT SWITCH(CS ) AND NOT SWITCH(ERROR ) THEN
        MC ZPOWER ON
;MC PRIME a.main
;WHILE NOT SWITCH(POWER)
;  TWAIT 0.01
;  MC CONTINUE
;END
      END
    END
;
    IF NOT SWITCH(REPEAT ) THEN
      CALL check.teach.pc
    END
    TWAIT 0.01
  END
;
.END
