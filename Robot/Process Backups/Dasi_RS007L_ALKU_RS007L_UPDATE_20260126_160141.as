    FOR .offset = 0 TO lines.count
      .left = .center.col-.offset
      .right = .center.col+.offset
; Left column
      IF .left>=0 THEN
        FOR .row = obj.in.line-1 TO 0 STEP -1
          ms[.cell] = .left
          ns[.cell] = .row
          .cell = .cell+1
        END
      END
