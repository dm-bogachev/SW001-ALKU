.PROGRAM defect.put()@26/01/23 15:56 #259
;
  IF count.defect>=max.defect.cnt THEN
    CALL log("Defect tare is full. Waiting for tare clean")
    $action = "Paused"
    WAIT count.defect==0
    $action = " "
  END
;
  SPEED 100 ALWAYS
  ACCURACY 100 ALWAYS
  TOOL tool.pick[current.gripper]
;
  POINT .temp = #defect.point[count.defect+1]
;
  JMOVE #safe.defect
;
  CALL log("Putting to defect tare with No:"+$ENCODE(count.defect+1))
;
  ACCURACY 10
  LAPPRO .temp,-30
  BREAK
;
  SPEED 150 MM/S
  ACCURACY 0.02
  LMOVE #defect.point[count.defect+1]
  BREAK
  TWAIT 0.3
  PULSE grip.unclamp
  TWAIT 0.3
  count.defect = count.defect+1
  SIGNAL -s.grip.full
;
  ACCURACY 10
  LAPPRO .temp,-30
  JMOVE #safe.defect
  LMOVE #homyak
;
.END
