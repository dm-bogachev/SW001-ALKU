	CALL set.vars.pc
	;
	MC PRIME a.main
	TWAIT 1
	;
	CALL watchdog.pc
	;
.END
.PROGRAM errstart.pc()@26/11/04 10:55 #744
	;
	IF ERROR == -34021 OR ERROR == -10100 THEN
		tcp.socket = -1
		MC ERESET
		TWAIT 1
	END
	TWAIT 5
	errstart.pc ON
	;
.END
