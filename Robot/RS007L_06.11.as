		.current.ot = 1
	END
	;
	.$temp = "Calc grid for" + $ENCODE (.current.ot) + "," + $ENCODE (lines.count)
	CALL log (.$temp)
	;
	FOR .i = 0 TO lines.count - 1
		FOR .j = 0 TO obj.in.line - 1
			POINT ot.put[.i, .j] = ot.frame + TRANS (-.i * lines.shift, -.j * .obj.shift)
		END
	END
	;
.END
