.PROGRAM state5()@26/11/07 17:31 #1194; Check etalon
	CALL log ("State 5: Check etalon")
	; TEMPORARY!!!!!!!!
	;  state = 101
	;  SIGNAL -s.cmd.chk.etal
	;  RETURN
	SIGNAL -s.etalon.ok, -s.etalon.ret, -s.etalon.ng
	IF recv.etalon == 99 THEN
		CALL etalon.measure (99)
