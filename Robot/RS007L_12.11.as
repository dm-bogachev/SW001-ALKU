.PROGRAM pos.pick()@26/11/07 17:31 #121547
	;
	BREAK
	SIGNAL rs7.locked.zone
	DELAY 0.1
	BREAK
	CALL log ("Check if zone is occupied")
	SWAIT -rs13.lock.zone
	CALL log ("Zone is free")
	;
