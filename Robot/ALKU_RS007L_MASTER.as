  END
; Log info
  .$temp = "Put gripper"+$ENCODE(.gripper.no)
  CALL log(.$temp)
; Set default motion parameters
  SPEED 10 ALWAYS
  ACCURACY 100 ALWAYS
  TOOL tool.pick[.gripper.no]
; Calculate points
  POINT .temp = #tool.point[.gripper.no]
; Motion
  LMOVE .temp+TRANS(0,0,200)
;
