  END
;
  .break = FALSE
  WHILE NOT .break DO
;TYPE 0: "intares", $intare.ids
    IF INSTR($outtare.ids , ",") THEN
      .id = VAL($DECODE($outtare.ids,",",0))
      CALL s.out.table(.id,outtare.i[outtare.count],outtare.j[outtare.count])
