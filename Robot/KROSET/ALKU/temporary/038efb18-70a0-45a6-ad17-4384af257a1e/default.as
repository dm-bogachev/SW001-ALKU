  JMOVE .temp+TRANS(0,0,30)
  BREAK
;
  SPEED 20 MM/S
  LMOVE #pos.pos[.pos]
  BREAK
  PULSE grip.clamp
  TWAIT 0.5
  pick.count = pick.count+1
;
  LMOVE .temp+TRANS(0,0,200)
  LMOVE #homyak
